# --- PostgreSQL (docker compose) ---
POSTGRES_DB=bank
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DB_MIGRATOR_PASSWORD=change-me
DB_APP_PASSWORD=change-me

# --- Server ---
PORT=4000
# hasła muszą być zgodne z DB_APP_PASSWORD / DB_MIGRATOR_PASSWORD powyżej
DATABASE_URL=postgres://bank_app:change-me@localhost:5432/bank
MIGRATION_DATABASE_URL=postgres://bank_migrator:change-me@localhost:5432/bank
