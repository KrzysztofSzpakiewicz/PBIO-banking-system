{
  "name": "pbio-banking-system",
  "private": true,
  "description": "Skrypty wspólne dla całego repozytorium (testy).",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec --import ./test/setup.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"server/test/**/!(*.integration).test.js\" \"client/test/**/!(*.integration).test.ts\"",
    "test:watch": "node --test --watch --test-reporter=spec --import ./test/setup.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"server/test/**/!(*.integration).test.js\" \"client/test/**/!(*.integration).test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"server/src/**\" --test-coverage-include=\"client/lib/**\" --test-reporter=spec --import ./test/setup.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"server/test/**/!(*.integration).test.js\" \"client/test/**/!(*.integration).test.ts\"",
    "test:integration": "docker compose up -d --wait db && npm run test:integration:run",
    "test:integration:run": "node --test --test-concurrency=1 --env-file-if-exists=.env --test-reporter=spec --import ./test/setup.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"server/test/**/*.integration.test.js\" \"client/test/**/*.integration.test.ts\"",
    "test:all": "npm test && npm run test:integration"
  }
}
