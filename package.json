{
  "name": "pbio-banking-system",
  "private": true,
  "description": "Skrypty wspólne dla całego repozytorium (testy).",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec --import ./test/setup.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"server/test/**/*.test.js\" \"client/test/**/*.test.ts\"",
    "test:watch": "node --test --test-reporter=spec --watch --import ./test/setup.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"server/test/**/*.test.js\" \"client/test/**/*.test.ts\"",
    "test:coverage": "node --test --test-reporter=spec --experimental-test-coverage --test-coverage-include=\"server/src/**\" --test-coverage-include=\"client/lib/**\" --import ./test/setup.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"server/test/**/*.test.js\" \"client/test/**/*.test.ts\""
  }
}
